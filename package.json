    }
  ],
  "maintainers": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "homepage": "https://github.com/malikrajat/rm-ng-export-to-csv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/rm-ng-export-to-csv.git"
  },
  "bugs": {
    "url": "https://github.com/malikrajat/rm-ng-export-to-csv/issues",
    "email": "mr.rajatmalik@gmail.com"
  },
  "peerDependencies": {
    "@angular/common": ">=16.0.0 <=26.0.0",
    "@angular/core": ">=16.0.0 <=26.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/malikrajat"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "packageGroup": [
      "rm-ng-export-to-csv"
    ]
  },
  "directories": {
    "lib": "./src",
    "doc": "./docs"
  },
  "packageManager": "pnpm@10.11.1",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "preferGlobal": false,
  "readme": "README.md",
  "module": "fesm2022/rm-ng-export-to-csv.mjs",
  "typings": "types/rm-ng-export-to-csv.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/rm-ng-export-to-csv.d.ts",
      "default": "./fesm2022/rm-ng-export-to-csv.mjs"
    }
  }
