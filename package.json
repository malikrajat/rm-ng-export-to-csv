    "array-to-csv",
    "object-to-csv",
    "convert-to-csv",
    "csv-converter",
    "file-export",
    "browser-download",
    "client-side-csv",
    "frontend-export",
    "typescript-csv",
    "ngx-csv",
    "angular-csv",
    "angular-export",
    "csv-generator",
    "data-table",
    "reporting",
    "data-management",
    "typescript",
    "web-utilities",
    "angular-utilities",
    "angular-tools",
    "angular-components"
  ],
  "author": {
    "name": "Rajat Malik",
